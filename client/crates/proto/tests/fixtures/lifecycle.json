    },
    "msg.reconnect_failed_net": {
      "ko": "pytmux: 재접속 실패 — 네트워크 확인",
      "en": "pytmux: reconnect failed — check network"
    },
    "msg.server_terminated": {
      "ko": "pytmux: 서버가 종료되었습니다",
      "en": "pytmux: server has terminated"
    },
    "msg.server_lost": {
      "ko": "pytmux: 서버 연결이 끊겼고 재접속에 실패했습니다 — 서버 프로세스가 외부에서 강제 종료됐는지 확인하세요(pythonw 일괄 kill 등)",
      "en": "pytmux: lost the server connection and could not reconnect — check whether the server process was killed externally (e.g. a blanket pythonw kill)"
    },
    "msg.reconnect_failed": {
      "ko": "pytmux: 서버 재접속 실패",
      "en": "pytmux: server reconnect failed"
    },
    "msg.proto_mismatch": {
      "ko": "pytmux: 서버와 프로토콜 버전이 다릅니다(서버 {server} · 클라 {client}) — 서버와 클라를 같은 판으로 맞추세요",
      "en": "pytmux: protocol version differs from the server (server {server} · client {client}) — run the same version of server and client"
    },
    "msg.auth_failed": {
      "ko": "pytmux: 서버가 인증을 거부했습니다 — 토큰이 맞지 않습니다(다른 사용자의 서버이거나 토큰 파일이 지워졌습니다)",
      "en": "pytmux: the server refused authentication — the token does not match (another user's server, or the token file was removed)"
    }
