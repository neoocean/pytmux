    "msg.server_restarting": {
      "ko": "pytmux: 서버 재시작 중…",
      "en": "pytmux: server restarting…"
    },
    "msg.restart_done": {
      "ko": "pytmux: 서버 재시작 완료 — 재접속됨",
      "en": "pytmux: server restarted — reconnected"
    },
    "msg.restart_done_win_noclient": {
      "ko": "pytmux: 전체 재시작 완료 — 세션 보존 (Windows: 클라 코드는 미갱신, 반영하려면 pytmux 재실행)",
      "en": "pytmux: full restart done — session preserved (Windows: client code not updated; relaunch pytmux to apply)"
    },
    "msg.reconnected_resync": {
      "ko": "pytmux: 재접속됨 — 화면 재동기",
      "en": "pytmux: reconnected — resyncing screen"
    },
    "msg.reconnecting": {
      "ko": "pytmux: 재접속 중…",
      "en": "pytmux: reconnecting…"
    },
    "msg.reconnecting_auto": {
