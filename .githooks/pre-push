#!/bin/bash
# git push 직전에 publish_check.py 를 실행한다 — 미러 드리프트를 방지한다(pytmux-153).
# git 설정에서 hooksPath = .githooks 로 지정되면 자동 실행된다.
# 실패하면 push 가 중단된다.
#
# --pre-push 를 준다(issue/pytmux-267) — git-unpushed-commits 갈래는 pre-push 시점에
# origin/main 이 아직 안 움직여 "지금 밀려는 그 커밋"이 언제나 잡히는 동어반복이라,
# 이 자리에서는 안 잰다. 내용·존재 드리프트(진짜 재야 할 것)는 그대로 잰다.

set -e

# ⛔ **`python3` 을 그냥 집지 않는다** — Windows 에서는 그 이름이
#    `…\WindowsApps\python3`(Store 앱 별칭 = 설치 런처)일 수 있고, 그것은 스크립트를
#    안 돌리고 "Python" 한 줄만 찍고 rc 49 로 죽는다(2026-08-23 실측, 이 상자).
#    그러면 이 훅은 **아무것도 안 재고 push 를 막기만 한다** — CLAUDE.md 가 `bash` 에
#    대해 적어 둔 함정(WindowsApps 별칭 = WSL 런처)과 **같은 것**이다.
#    다른 데 있으면 `PYTMUX_PYTHON=<경로>`.
#
# ⛔ 그 «고르는 법»을 여기에 두 번째로 적지 않는다 — 같은 줄이 셸 게이트 둘에도 있었고
#    (pytmux-383) 이쪽만 먼저 고쳐 놓아 셋이 갈려 있었다. 정본은 한 파일이다.
#    (훅은 언제나 작업 트리 꼭대기에서 돈다 — 그래도 hooksPath 를 어떻게 걸었든 같은
#     답이 나오게 git 에게 뿌리를 물어서 연다.)
. "$(git rev-parse --show-toplevel)/scripts/pick_python.sh"

PY=$(pick_python) || {
    echo "pre-push: 쓸 만한 파이썬 3 을 못 찾았다 — 미러 드리프트를 못 쟀다" >&2
    echo "  → 못 쟀으면 통과가 아니다. PYTMUX_PYTHON=<경로> 로 지정할 것" >&2
    exit 2
}

echo "⏳ 미러 드리프트 검사 중... ($PY)"
"$PY" scripts/publish_check.py --pre-push
echo "✓ 미러 드리프트 검사 통과"
